diff --git a/cmake_modules/Findpagmo_IPOPT.cmake b/cmake_modules/Findpagmo_IPOPT.cmake
index 46136bd..eff816c 100644
--- a/cmake_modules/Findpagmo_IPOPT.cmake
+++ b/cmake_modules/Findpagmo_IPOPT.cmake
@@ -56,5 +56,14 @@ if ("libipopt" IN_LIST pagmo_IPOPT_FIND_COMPONENTS)
         find_package(LAPACK REQUIRED)
         set_property(TARGET pagmo::IPOPT::libipopt APPEND PROPERTY
             INTERFACE_LINK_LIBRARIES LAPACK::LAPACK ${CMAKE_DL_LIBS})
+        # Ipopt may be built against MUMPS. When libipopt is a static library
+        # the solver's symbols are only resolved at the final link, so they
+        # have to be propagated to whatever consumes pagmo.
+        find_package(MUMPS CONFIG QUIET)
+        if(MUMPS_FOUND)
+            message(STATUS "Ipopt was built with MUMPS; propagating MUMPS::DMUMPS.")
+            set_property(TARGET pagmo::IPOPT::libipopt APPEND PROPERTY
+                INTERFACE_LINK_LIBRARIES MUMPS::DMUMPS)
+        endif()
     endif()
 endif()
