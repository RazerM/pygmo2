{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "pygmo",
  "description": "Parallel optimisation for Python",
  "homepage": "https://github.com/esa/pygmo2",
  "builtin-baseline": "9eec002df1cd109f8f104cd966a763daf9751489",
  "dependencies": [
    {
      "name": "nlopt",
      "features": [
        "luksan"
      ]
    },
    {
      "name": "pagmo2",
      "features": [
        "nlopt"
      ]
    }
  ],
  "default-features": [
    {
      "name": "ipopt",
      "platform": "!(windows & arm)"
    }
  ],
  "features": {
    "ipopt": {
      "description": "Build pygmo.ipopt",
      "dependencies": [
        {
          "name": "coin-or-ipopt",
          "features": [
            "mumps"
          ]
        },
        {
          "name": "openblas",
          "features": [
            "dynamic-arch"
          ],
          "platform": "linux & (x64 | arm64)"
        },
        {
          "name": "pagmo2",
          "features": [
            "ipopt"
          ]
        }
      ]
    }
  }
}
